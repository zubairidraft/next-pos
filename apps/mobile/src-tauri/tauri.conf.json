{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Next POS Mobile",
  "version": "0.1.0",
  "identifier": "com.nextpos.mobile",
  "build": {
    "frontendDist": "../../desktop/dist-mobile",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm --prefix ../desktop run dev:mobile",
    "beforeBuildCommand": "npm --prefix ../desktop run build:mobile"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Next POS",
        "width": 400,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
